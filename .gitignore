/bazel-*
/MODULE.bazel.lock.bak

# Host Godot editor cache. Place is not a Bazel package.
# Do not bake the Godot editor into the repo.
**/.godot/
/tools/godot

# Host Blender CLI. Known leak, like host Godot. Do not commit Blender.
/tools/blender
/tools/blender-*/

# QA-only Blender export (regenerated). Committed fixture stays.
/place/art/.qa_*

# Export templates and built binaries stay out.
**/*.tpz
**/editor_data/export_templates/
/tools/export-templates/
/tools/godot-templates/
/dist/
/export/
